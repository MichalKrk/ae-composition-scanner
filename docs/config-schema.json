{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/composition-config.schema.json",
  "title": "Composition Configuration",
  "description": "Schema for After Effects composition configuration generated by scanCompositionConfig.jsx",
  "type": "object",
  "required": ["compositionName", "aeVersion", "fonts", "plugins", "Hook", "Body", "CTA", "music"],
  "properties": {
    "compositionName": {
      "type": "string",
      "description": "Name of the main composition"
    },
    "aeVersion": {
      "type": "string",
      "description": "After Effects version number (e.g., '24.1.0')"
    },
    "fonts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of unique font names used across all compositions (sorted alphabetically)"
    },
    "plugins": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Plugin"
      },
      "description": "Array of unique third-party plugins/effects used across all compositions (excludes built-in Adobe effects)"
    },
    "Hook": {
      "oneOf": [
        { "$ref": "#/definitions/Section" },
        { "type": "null" }
      ],
      "description": "Hook section configuration (null if not found)"
    },
    "Body": {
      "oneOf": [
        { "$ref": "#/definitions/Section" },
        { "type": "null" }
      ],
      "description": "Body section configuration (null if not found)"
    },
    "CTA": {
      "oneOf": [
        { "$ref": "#/definitions/Section" },
        { "type": "null" }
      ],
      "description": "CTA (Call-to-Action) section configuration (null if not found)"
    },
    "music": {
      "oneOf": [
        { "$ref": "#/definitions/Music" },
        { "type": "null" }
      ],
      "description": "Music layer configuration (null if not found)"
    }
  },
  "definitions": {
    "Section": {
      "type": "object",
      "required": ["compositionName", "voice", "subtitles", "textBoxes", "footages"],
      "properties": {
        "compositionName": {
          "type": "string",
          "description": "Name of the section sub-composition"
        },
        "voice": {
          "oneOf": [
            { "$ref": "#/definitions/Voice" },
            { "type": "null" }
          ],
          "description": "Voiceover data (null if not found)"
        },
        "subtitles": {
          "oneOf": [
            { "$ref": "#/definitions/Subtitles" },
            { "type": "null" }
          ],
          "description": "Subtitle/text layer data (null if not found)"
        },
        "textBoxes": {
          "oneOf": [
            { "$ref": "#/definitions/TextBoxes" },
            { "type": "null" }
          ],
          "description": "Text box controls data (null if not found)"
        },
        "footages": {
          "type": "array",
          "items": { "$ref": "#/definitions/Footage" },
          "description": "Array of footage/video layers (empty array if none)"
        }
      }
    },
    "Voice": {
      "type": "object",
      "required": ["sourceName", "layerName", "voiceName", "voiceID", "format", "isSanitized", "cloneType"],
      "properties": {
        "sourceName": {
          "type": "string",
          "description": "Source file name"
        },
        "layerName": {
          "type": "string",
          "description": "Layer name in composition"
        },
        "voiceName": {
          "type": ["string", "null"],
          "description": "Extracted voice name (null if parsing failed)"
        },
        "voiceID": {
          "type": ["string", "null"],
          "pattern": "^[a-zA-Z0-9]{20}$",
          "description": "20-character voice ID (null for ElevenLabs format or if not found)"
        },
        "format": {
          "type": "string",
          "enum": ["Voiceover", "ElevenLabs", "11labs", "unknown"],
          "description": "Detected voiceover format"
        },
        "isSanitized": {
          "type": "boolean",
          "description": "Whether the voice name has been sanitized (true for 11labs format)"
        },
        "cloneType": {
          "type": ["string", "null"],
          "description": "Clone type for ElevenLabs voices (e.g., 'pre', 'ivc'), null for Voiceover format"
        }
      }
    },
    "Subtitles": {
      "type": "object",
      "required": ["fontName", "fontSize", "fillColor", "strokeColor", "strokeWidth", "applyStroke", "fontCapsOption", "tracking", "leading", "autoLeading", "numLines", "maxChars", "wordCount", "transform"],
      "properties": {
        "fontName": {
          "type": "string",
          "description": "Font family name"
        },
        "fontSize": {
          "type": "number",
          "description": "Font size in pixels"
        },
        "fillColor": {
          "type": "array",
          "items": { "type": "number", "minimum": 0, "maximum": 255 },
          "minItems": 3,
          "maxItems": 3,
          "description": "Fill color as RGB array [R, G, B] (0-255 range)"
        },
        "strokeColor": {
          "type": "array",
          "items": { "type": "number", "minimum": 0, "maximum": 255 },
          "minItems": 3,
          "maxItems": 3,
          "description": "Stroke color as RGB array [R, G, B] (0-255 range)"
        },
        "strokeWidth": {
          "type": "number",
          "description": "Stroke width in pixels"
        },
        "applyStroke": {
          "type": "boolean",
          "description": "Whether stroke is applied"
        },
        "fontCapsOption": {
          "type": "string",
          "description": "Font caps option (e.g., 'Normal', 'All Caps')"
        },
        "tracking": {
          "type": "number",
          "description": "Character spacing/tracking"
        },
        "leading": {
          "type": ["number", "null"],
          "description": "Line spacing/leading (null if auto)"
        },
        "autoLeading": {
          "type": "boolean",
          "description": "Whether auto-leading is enabled"
        },
        "numLines": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of text lines"
        },
        "maxChars": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum characters per line"
        },
        "wordCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Total word count"
        },
        "transform": {
          "type": "object",
          "required": ["position", "scale", "rotation", "opacity", "anchorPoint"],
          "properties": {
            "position": {
              "$ref": "#/definitions/AnimatableProperty",
              "description": "Position [x, y, z]"
            },
            "scale": {
              "$ref": "#/definitions/AnimatableProperty",
              "description": "Scale [x%, y%, z%]"
            },
            "rotation": {
              "$ref": "#/definitions/AnimatableProperty",
              "description": "Rotation in degrees"
            },
            "opacity": {
              "$ref": "#/definitions/AnimatableProperty",
              "description": "Opacity percentage (0-100)"
            },
            "anchorPoint": {
              "$ref": "#/definitions/AnimatableProperty",
              "description": "Anchor point [x, y, z]"
            }
          }
        }
      }
    },
    "TextBoxes": {
      "type": "object",
      "required": ["boxType", "layerName", "parameters"],
      "properties": {
        "boxType": {
          "type": "string",
          "enum": ["Accent", "Adaptive", "Text"],
          "description": "Type of text box control"
        },
        "layerName": {
          "type": "string",
          "description": "Layer name of the text box control"
        },
        "parameters": {
          "type": "object",
          "description": "Effect parameters (varies by box type)",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["Slider", "Color", "Checkbox", "Point"],
                "description": "Parameter type"
              },
              "value": {
                "description": "Parameter value (type depends on parameter type)"
              }
            },
            "required": ["type", "value"]
          }
        }
      }
    },
    "Footage": {
      "type": "object",
      "required": ["layerName", "sourceName", "inPoint", "outPoint", "duration", "enabled", "order"],
      "properties": {
        "layerName": {
          "type": "string",
          "description": "Layer name in composition"
        },
        "sourceName": {
          "type": "string",
          "description": "Source file name"
        },
        "inPoint": {
          "type": "number",
          "minimum": 0,
          "description": "Start time in composition timeline (seconds)"
        },
        "outPoint": {
          "type": "number",
          "minimum": 0,
          "description": "End time in composition timeline (seconds)"
        },
        "duration": {
          "type": "number",
          "minimum": 0,
          "description": "Duration of layer presence in timeline (outPoint - inPoint)"
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether the layer is enabled"
        },
        "order": {
          "type": "integer",
          "minimum": 1,
          "description": "Playback order (sorted by inPoint, 1-based)"
        }
      }
    },
    "Music": {
      "type": "object",
      "required": ["layerName", "layerIndex", "sourceName", "inPoint", "outPoint", "duration", "enabled", "audioLevels"],
      "properties": {
        "layerName": {
          "type": "string",
          "description": "Layer name in main composition"
        },
        "layerIndex": {
          "type": "integer",
          "minimum": 1,
          "description": "Layer index in composition (1-based)"
        },
        "sourceName": {
          "type": "string",
          "description": "Source file name"
        },
        "inPoint": {
          "type": "number",
          "minimum": 0,
          "description": "Start time in composition timeline (seconds)"
        },
        "outPoint": {
          "type": "number",
          "minimum": 0,
          "description": "End time in composition timeline (seconds)"
        },
        "duration": {
          "type": "number",
          "minimum": 0,
          "description": "Duration of layer presence in timeline (outPoint - inPoint)"
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether the layer is enabled"
        },
        "audioLevels": {
          "type": ["object", "null"],
          "description": "Audio levels data (null if not available)",
          "properties": {
            "value": {
              "type": "array",
              "description": "Audio level values"
            },
            "isAnimated": {
              "type": "boolean",
              "description": "Whether audio levels are keyframed"
            },
            "numKeys": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of keyframes (0 if not animated)"
            }
          }
        }
      }
    },
    "AnimatableProperty": {
      "type": "object",
      "required": ["value", "isAnimated", "numKeys"],
      "properties": {
        "value": {
          "description": "Property value (can be number, array, etc.)"
        },
        "isAnimated": {
          "type": "boolean",
          "description": "Whether the property has keyframes"
        },
        "numKeys": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of keyframes (0 if not animated)"
        }
      }
    },
    "Plugin": {
      "type": "object",
      "required": ["name", "matchName"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Display name of the plugin/effect"
        },
        "matchName": {
          "type": "string",
          "description": "Internal match name of the plugin/effect (used for identification)"
        }
      }
    }
  }
}
